{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/matches",
      "destination": "/api/matches.ts"
    },
    {
      "source": "/api/search",
      "destination": "/api/search.ts"
    },
    {
      "source": "/api/competitions",
      "destination": "/api/competitions.ts"
    },
    {
      "source": "/api/debug",
      "destination": "/api/debug.ts"
    },
    {
      "source": "/api/health",
      "destination": "/api/health.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/matches",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/api/search",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    }
  ]
}
